# Root gitignore for the Bhu-Nirakshak monorepo

# Node dependencies
node_modules/
backend/node_modules/
client1/node_modules/

# Build output
backend/dist/
client1/dist/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# Environment & secrets
.env
*.env
backend/.env
client1/.env

# OS / editor specific
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Uploaded user files (kept in storage, not in git)
backend/uploads/

# Misc
*.local


